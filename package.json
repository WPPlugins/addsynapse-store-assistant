{
  "name": "addsynapse-store-assistant",
  "version": "1.3.5",
  "private": true,
  "description": "Admin chat UI of the AddSynapse Store Assistant WordPress plugin.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build src/index.js --output-path=build",
    "postbuild": "node -e \"var fs=require('fs'),f='build/index.asset.php',s=fs.readFileSync(f,'utf8');if(s.indexOf('ABSPATH')<0){fs.writeFileSync(f,s.replace('<?php ','<?php defined( \\'ABSPATH\\' ) || exit; '))}\"",
    "start": "wp-scripts start src/index.js --output-path=build",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss'"
  },
  "devDependencies": {
    "@wordpress/scripts": "30.27.0",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "@wordpress/api-fetch": "7.56.0",
    "@wordpress/components": "41.0.0",
    "@wordpress/element": "8.8.0",
    "@wordpress/i18n": "6.29.0",
    "@wordpress/icons": "17.0.0",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1"
  }
}
